# Production Environment Variables for Medical Imaging Viewer Frontend
# Backend API URL (Google Cloud Run - us-central1 for FREE TIER)
VITE_API_BASE_URL=https://brain-mri-7bp6oqdu7a-uc.a.run.app

# In-browser FLAMeS with skull removal on the server (REQ-FUNC-093, REQ-FUNC-115). Turned on with the owner's sign-off of this change.
VITE_ENABLE_BROWSER_FLAMES=true

# Slice-thickness reliability card (CP-SLICE-THICKNESS-001, RC-058): ON for the research stage by the owner's
# decision of 2026-11-13 (PR #82, DRAFT, PENDING owner approval). HAZ-015 stays UNDETERMINED; close it before any clinical use.
VITE_ENABLE_SLICE_THICKNESS_RELIABILITY=true

# Single quality gate (PR #81, RC-122..RC-127): ON for the research stage by the owner's decision of 2026-11-14
# (DRAFT, PENDING owner approval). Works with QUALITY_GATE_ENFORCED and the agent switches on the server (cloudbuild.yaml).
VITE_ENABLE_QUALITY_GATE=true
